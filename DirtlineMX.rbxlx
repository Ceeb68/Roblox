            <string name="Source"><![CDATA[--!strict
-- Fictional 250cc four-stroke calibration, in SI units. These are prototype
-- engineering values, not manufacturer measurements or an MX Bikes replica.
local Bike250 = {
	Name = "DL-MX 250F",
	Version = 1,
	MetresPerStud = 0.28,
	Gravity = 9.81,
	FixedStep = 1 / 240,
	MaxSubsteps = 12,
	BikeMass = 109,
	RiderMass = 78,
	Wheelbase = 1.48,
	FrontRadius = 0.348,
	RearRadius = 0.335,
	FrontInertia = 0.62,
	RearInertia = 0.72,
	Steering = {
		MaxAngle = math.rad(34),
		Inertia = 0.42,
		InputTorque = 16,
		Damping = 2.5,
		Trail = 0.085,
		Caster = math.rad(26),
	},
	Rider = {
		ForeAftTravel = 0.26,
		SideTravel = 0.18,
		StandingHeight = 0.22,
		MoveRate = 2.2,
		RollInertia = 3.2,
		PitchInertia = 5.2,
		MaxRoll = math.rad(23),
		MaxPitch = math.rad(28),
		MaxReactionTorque = 75,
	},
	Suspension = {
		Front = { RestLength = 0.47, Travel = 0.30, SpringRate = 18000, Compression = 1500, Rebound = 2100, Preload = 0.012, BumpRate = 140000 },
		Rear = { RestLength = 0.44, Travel = 0.30, SpringRate = 19500, Compression = 1700, Rebound = 2400, Preload = 0.014, BumpRate = 155000 },
	},
	Tire = {
		LongitudinalStiffness = 10,
		LateralStiffness = 7,
		CamberStiffness = 0.65,
		RelaxationLength = 0.25,
		MinimumSpeed = 1.5,
		ReferenceLoad = 920,
		LoadSensitivity = 0.10,
		RollingResistance = 0.015,
	},
	Surfaces = {
		dirt = { Grip = 0.85, Rolling = 0.025 },
		loam = { Grip = 0.90, Rolling = 0.04 },
		hardpack = { Grip = 1.02, Rolling = 0.015 },
		sand = { Grip = 0.62, Rolling = 0.085 },
		mud = { Grip = 0.40, Rolling = 0.06 },
		grass = { Grip = 0.60, Rolling = 0.03 },
		concrete = { Grip = 1.05, Rolling = 0.012 },
	},
	Drive = {
		IdleRPM = 2200,
		StallRPM = 650,
		RedlineRPM = 13500,
		EngineInertia = 0.035,
		RearInertia = 0.72,
		PrimaryRatio = 3.35,
		FinalRatio = 3.85,
		GearRatios = { 2.14, 1.75, 1.45, 1.22, 1.06 },
		Efficiency = 0.94,
		ClutchCapacity = 43,
		EngineBrakeTorque = 7.5,
		FrictionTorque = 1.3,
		ShiftCutTime = 0.07,
		FrontBrakeTorque = 340,
		RearBrakeTorque = 190,
		TorqueCurve = { { 0, 0 }, { 2200, 10 }, { 4000, 17 }, { 6500, 23 }, { 9000, 28.5 }, { 11000, 27 }, { 12500, 22 }, { 13500, 15 } },
	},
	Crash = {
		GroundRoll = math.rad(67),
		LoopPitch = math.rad(82),
		LandingAngle = math.rad(38),
		LandingSpeed = 7.5,
		SideLandingSpeed = 6,
		RecoveryDelay = 2.5,
	},
}

return Bike250
]]></string>
