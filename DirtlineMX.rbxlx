  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Motocross</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Bikes</string>
          <string name="Source"><![CDATA[--!strict

-- Server-owned arcade bikes. Forces keep gravity and ramp launches intact;
-- an orientation constraint supplies the balance a two-wheel vehicle needs.
local Players = game:GetService("Players")

local Bikes = {}
Bikes.__index = Bikes

local TOP_SPEED = 100 -- studs/second (about 101 km/h)
local REVERSE_SPEED = 24
local ENGINE_ACCELERATION = 44
local BRAKE_ACCELERATION = 95
local INPUT_TIMEOUT = 0.5
local STUDS_TO_KMH = 0.28 * 3.6
local WHEEL_RADIUS = 1.05
local WHEEL_BASE = 1.75
local WHEEL_HEIGHT = -0.7

local ORANGE = Color3.fromRGB(255, 119, 34)
local TEAL = Color3.fromRGB(28, 218, 192)
local BLACK = Color3.fromRGB(23, 29, 35)
local METAL = Color3.fromRGB(148, 161, 172)

type BikeRecord = {
	model: Model,
	chassis: Part,
	seat: VehicleSeat,
	force: VectorForce,
	balance: AlignOrientation,
	connections: { RBXScriptConnection },
	wheels: { Motor6D },
	wheelOffsets: { CFrame },
	yaw: number,
	normal: Vector3,
	wheelAngle: number,
	wheelElapsed: number,
	throttle: number,
	steer: number,
	brake: boolean,
	lastInput: number,
	lastAcceptedInput: number,
	raycast: RaycastParams,
}

type Service = {
	_folder: Folder,
	_bikes: { [Player]: BikeRecord },
	spawn: (Service, Player, CFrame) -> Model,
	remove: (Service, Player) -> (),
	input: (Service, Player, number, number, boolean) -> (),
	update: (Service, number) -> (),
	getBike: (Service, Player) -> Model?,
	getSpeed: (Service, Player) -> number,
	getPosition: (Service, Player) -> Vector3?,
	isRiding: (Service, Player) -> boolean,
}

local function finite(value: number): boolean
	return value == value and value > -math.huge and value < math.huge
end

local function unitOr(vector: Vector3, fallback: Vector3): Vector3
	if vector.Magnitude > 0.001 then
		return vector.Unit
	end
	return fallback
end

local function weld(base: BasePart, part: BasePart)
	local connection = Instance.new("WeldConstraint")
	connection.Part0 = base
	connection.Part1 = part
	connection.Parent = part
end

local function cosmetic(
	model: Model,
	base: BasePart,
	name: string,
	size: Vector3,
	localCFrame: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = base.CFrame * localCFrame
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	weld(base, part)
	return part
end

local function rod(model: Model, base: BasePart, name: string, a: Vector3, b: Vector3, width: number, color: Color3)
	local midpoint = (a + b) / 2
	local localCFrame = CFrame.lookAt(midpoint, b) * CFrame.Angles(0, math.pi / 2, 0)
	local part = cosmetic(model, base, name, Vector3.new((b - a).Magnitude, width, width), localCFrame, color, Enum.Material.Metal)
	part.Shape = Enum.PartType.Cylinder
end

local function makeWheel(model: Model, chassis: Part, z: number, accent: Color3): (Motor6D, CFrame)
	local offset = CFrame.new(0, WHEEL_HEIGHT, z)
	local tire = Instance.new("Part")
	tire.Name = if z < 0 then "FrontTire" else "RearTire"
	tire.Shape = Enum.PartType.Cylinder
	tire.Size = Vector3.new(0.62, WHEEL_RADIUS * 2, WHEEL_RADIUS * 2)
	tire.CFrame = chassis.CFrame * offset
	tire.Color = BLACK
	tire.Material = Enum.Material.Slate
	tire.CanCollide = false
	tire.CanTouch = false
	tire.CanQuery = false
	tire.Massless = true
	tire.Parent = model

	local motor = Instance.new("Motor6D")
	motor.Name = tire.Name .. "Axle"
	motor.Part0 = chassis
	motor.Part1 = tire
	motor.C0 = offset
	motor.Parent = chassis

	for _, x in { -0.33, 0.33 } do
		local rim = cosmetic(model, tire, "Rim", Vector3.new(0.05, 1.54, 1.54), CFrame.new(x, 0, 0), accent, Enum.Material.Metal)
		rim.Shape = Enum.PartType.Cylinder
		local inside = cosmetic(model, tire, "RimInset", Vector3.new(0.065, 1.32, 1.32), CFrame.new(x, 0, 0), BLACK)
		inside.Shape = Enum.PartType.Cylinder
		for spoke = 0, 5 do
			cosmetic(model, tire, "Spoke", Vector3.new(0.08, 0.055, 1.36), CFrame.new(x, 0, 0) * CFrame.Angles(spoke * math.pi / 6, 0, 0), METAL, Enum.Material.Metal)
		end
	end
	local hub = cosmetic(model, tire, "Hub", Vector3.new(0.8, 0.3, 0.3), CFrame.identity, METAL, Enum.Material.Metal)
	hub.Shape = Enum.PartType.Cylinder

	-- Rounded contact proxies avoid the snagging a welded, nonrolling cylinder
	-- causes on ramp seams. Their visual wheels remain narrow motorcycle tires.
	local contact = cosmetic(model, chassis, tire.Name .. "Contact", Vector3.one * (WHEEL_RADIUS * 2), offset, BLACK)
	contact.Shape = Enum.PartType.Ball
	contact.Transparency = 1
	contact.CanCollide = true
	contact.CustomPhysicalProperties = PhysicalProperties.new(1, 0.03, 0, 100, 1)
	return motor, offset
end

local function riding(player: Player, record: BikeRecord): boolean
	local humanoid = record.seat.Occupant
	return humanoid ~= nil and humanoid.Health > 0 and humanoid.Parent == player.Character
end

local function buildBike(player: Player, spawnCFrame: CFrame): BikeRecord
	local model = Instance.new("Model")
	model.Name = player.Name .. "_DirtBike"
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("BikeName", "Dirtline 250")

	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = Vector3.new(1.35, 0.85, 3.6)
	chassis.CFrame = spawnCFrame
	chassis.Transparency = 1
	chassis.CanCollide = true
	chassis.RootPriority = 127
	chassis.CustomPhysicalProperties = PhysicalProperties.new(3, 0.03, 0, 100, 1)
	chassis.Parent = model
	model.PrimaryPart = chassis

	cosmetic(model, chassis, "Engine", Vector3.new(0.9, 0.8, 1.15), CFrame.new(0, 0.05, 0.25), METAL, Enum.Material.Metal)
	cosmetic(model, chassis, "Tank", Vector3.new(0.95, 0.65, 1.45), CFrame.new(0, 0.75, -0.35) * CFrame.Angles(math.rad(-9), 0, 0), ORANGE)
	cosmetic(model, chassis, "Tail", Vector3.new(0.82, 0.22, 1.7), CFrame.new(0, 1.03, 0.9) * CFrame.Angles(math.rad(5), 0, 0), ORANGE)
	cosmetic(model, chassis, "FrontMudguard", Vector3.new(0.88, 0.15, 1.85), CFrame.new(0, 0.58, -1.65), ORANGE)
	cosmetic(model, chassis, "RearMudguard", Vector3.new(0.85, 0.15, 1.65), CFrame.new(0, 0.58, 1.65), TEAL)
	for _, x in { -0.43, 0.43 } do
		rod(model, chassis, "FrameRail", Vector3.new(x, -0.2, 0.8), Vector3.new(x, 0.7, -1.15), 0.14, ORANGE)
		rod(model, chassis, "Swingarm", Vector3.new(x, -0.1, 0.2), Vector3.new(x, WHEEL_HEIGHT, WHEEL_BASE), 0.16, METAL)
		rod(model, chassis, "FrontFork", Vector3.new(x * 0.8, WHEEL_HEIGHT, -WHEEL_BASE), Vector3.new(x * 0.8, 1.4, -1.05), 0.15, METAL)
		cosmetic(model, chassis, "SideNumberPlate", Vector3.new(0.09, 0.6, 0.95), CFrame.new(x * 1.3, 0.6, 0.7), TEAL)
		cosmetic(model, chassis, "FootPeg", Vector3.new(0.4, 0.13, 0.35), CFrame.new(x * 1.65, -0.1, 0.4), BLACK, Enum.Material.Metal)
	end
	rod(model, chassis, "Handlebar", Vector3.new(-0.95, 1.72, -1.03), Vector3.new(0.95, 1.72, -1.03), 0.12, METAL)
	for _, x in { -0.85, 0.85 } do
		local grip = cosmetic(model, chassis, "HandlebarGrip", Vector3.new(0.38, 0.18, 0.18), CFrame.new(x, 1.72, -1.03), BLACK)
		grip.Shape = Enum.PartType.Cylinder
	end
	rod(model, chassis, "ExhaustPipe", Vector3.new(0.54, 0.05, -0.2), Vector3.new(0.6, 0.68, 1.6), 0.2, METAL)
	local muffler = cosmetic(model, chassis, "Muffler", Vector3.new(0.95, 0.32, 0.32), CFrame.new(0.61, 0.73, 1.23) * CFrame.Angles(0, math.pi / 2, 0), BLACK, Enum.Material.Metal)
	muffler.Shape = Enum.PartType.Cylinder

	local plate = cosmetic(model, chassis, "FrontNumberPlate", Vector3.new(0.83, 0.65, 0.13), CFrame.new(0, 1.13, -1.33), Color3.fromRGB(244, 248, 251))
	local plateGui = Instance.new("SurfaceGui")
	plateGui.Face = Enum.NormalId.Front
	plateGui.CanvasSize = Vector2.new(200, 150)
	plateGui.LightInfluence = 0.2
	plateGui.Parent = plate
	local plateText = Instance.new("TextLabel")
	plateText.Size = UDim2.fromScale(1, 1)
	plateText.BackgroundTransparency = 1
	plateText.Font = Enum.Font.GothamBlack
	plateText.Text = "MX"
	plateText.TextScaled = true
	plateText.TextColor3 = BLACK
	plateText.Parent = plateGui

	local seat = Instance.new("VehicleSeat")
	seat.Name = "DriverSeat"
	seat.Size = Vector3.new(0.86, 0.24, 1.5)
	seat.CFrame = chassis.CFrame * CFrame.new(0, 1.17, 0.5)
	seat.Color = BLACK
	seat.Material = Enum.Material.SmoothPlastic
	seat.CanCollide = false
	seat.CanTouch = false
	seat.Massless = true
	seat.HeadsUpDisplay = false
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.Parent = model
	weld(chassis, seat)

	local frontWheel, frontOffset = makeWheel(model, chassis, -WHEEL_BASE, ORANGE)
	local rearWheel, rearOffset = makeWheel(model, chassis, WHEEL_BASE, TEAL)
	local attachment = Instance.new("Attachment")
	attachment.Name = "BikeCenter"
	attachment.Parent = chassis
	local force = Instance.new("VectorForce")
	force.Name = "EngineAndGrip"
	force.Attachment0 = attachment
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.ApplyAtCenterOfMass = true
	force.Parent = chassis
	local balance = Instance.new("AlignOrientation")
	balance.Name = "RiderBalance"
	balance.Mode = Enum.OrientationAlignmentMode.OneAttachment
	balance.Attachment0 = attachment
	balance.MaxTorque = 10000000
	balance.MaxAngularVelocity = 7
	balance.Responsiveness = 22
	balance.RigidityEnabled = false
	balance.CFrame = spawnCFrame.Rotation
	balance.Parent = chassis

	local look = spawnCFrame.LookVector
	local direction = unitOr(Vector3.new(look.X, 0, look.Z), Vector3.new(0, 0, -1))
	local raycast = RaycastParams.new()
	raycast.FilterType = Enum.RaycastFilterType.Exclude
	raycast.RespectCanCollide = true
	return {
		model = model,
		chassis = chassis,
		seat = seat,
		force = force,
		balance = balance,
		connections = {},
		wheels = { frontWheel, rearWheel },
		wheelOffsets = { frontOffset, rearOffset },
		yaw = math.atan2(-direction.X, -direction.Z),
		normal = Vector3.yAxis,
		wheelAngle = 0,
		wheelElapsed = 0,
		throttle = 0,
		steer = 0,
		brake = true,
		lastInput = -math.huge,
		lastAcceptedInput = -math.huge,
		raycast = raycast,
	}
end

function Bikes.new(world: Instance): Service
	local folder = Instance.new("Folder")
	folder.Name = "DirtBikes"
	folder.Parent = world
	return setmetatable({ _folder = folder, _bikes = {} }, Bikes) :: any
end

function Bikes.spawn(self: Service, player: Player, spawnCFrame: CFrame): Model
	self:remove(player)
	local record = buildBike(player, spawnCFrame)
	self._bikes[player] = record
	record.model.Parent = self._folder
	-- Keep both the bike and its seated rider under server physics authority.
	record.chassis:SetNetworkOwner(nil)

	local function seatCharacter(character: Model)
		local function attempt(humanoid: Humanoid)
			if self._bikes[player] ~= record or player.Character ~= character or humanoid.Health <= 0 then
				return
			end
			character:PivotTo(record.seat.CFrame * CFrame.new(0, 3, 0))
			record.seat:Sit(humanoid)
			task.delay(0.2, function()
				if self._bikes[player] == record and player.Character == character and humanoid.Health > 0 and record.seat.Occupant == nil then
					record.seat:Sit(humanoid)
				end
			end)
		end
		local pending: RBXScriptConnection? = nil
		local function whenReady(): boolean
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local rootPart = character:FindFirstChild("HumanoidRootPart")
			if humanoid and rootPart and rootPart:IsA("BasePart") then
				if pending then pending:Disconnect() end
				attempt(humanoid)
				return true
			end
			return false
		end
		if whenReady() then return end
		pending = character.ChildAdded:Connect(function()
			whenReady()
		end)
		table.insert(record.connections, pending :: RBXScriptConnection)
		task.delay(8, function()
			if pending then pending:Disconnect() end
		end)
	end

	table.insert(record.connections, player.CharacterAdded:Connect(seatCharacter))
	table.insert(record.connections, record.seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local occupant = record.seat.Occupant
		if occupant and occupant.Parent ~= player.Character then
			occupant.Sit = false
		end
		-- Seating changes the assembly; reaffirm server authority for it.
		if record.chassis:IsDescendantOf(workspace) and record.chassis:CanSetNetworkOwnership() then
			record.chassis:SetNetworkOwner(nil)
		end
		record.throttle = 0
		record.steer = 0
		record.brake = true
		record.lastInput = -math.huge
	end))
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RidePrompt"
	prompt.ActionText = "Ride"
	prompt.ObjectText = "Dirtline 250"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.Parent = record.seat
	table.insert(record.connections, prompt.Triggered:Connect(function(triggeringPlayer)
		if triggeringPlayer == player and not riding(player, record) and player.Character then
			seatCharacter(player.Character)
		end
	end))
	if player.Character then
		task.defer(seatCharacter, player.Character)
	end
	return record.model
end

function Bikes.remove(self: Service, player: Player)
	local record = self._bikes[player]
	if not record then return end
	self._bikes[player] = nil
	for _, connection in record.connections do connection:Disconnect() end
	if record.seat.Occupant then record.seat.Occupant.Sit = false end
	record.model:Destroy()
end

function Bikes.input(self: Service, player: Player, throttle: number, steer: number, brake: boolean)
	local record = self._bikes[player]
	if not record or not riding(player, record) then return end
	-- Remote arguments still need runtime validation despite the Luau signature.
	if typeof(throttle) ~= "number" or typeof(steer) ~= "number" or typeof(brake) ~= "boolean" then return end
	if not finite(throttle) or not finite(steer) then return end
	local now = os.clock()
	if now - record.lastAcceptedInput < 1 / 120 then return end
	record.lastAcceptedInput = now
	record.lastInput = now
	record.throttle = math.clamp(throttle, -1, 1)
	record.steer = math.clamp(steer, -1, 1)
	record.brake = brake
end

function Bikes.update(self: Service, frameDt: number)
	if not finite(frameDt) or frameDt <= 0 then return end
	-- Limit steering integration after a server stall, while avoiding a force
	-- impulse from dividing by a nearly zero timestep.
	local dt = math.clamp(frameDt, 1 / 240, 1 / 20)
	local now = os.clock()
	local exclusions: { Instance } = { self._folder }
	for _, otherPlayer in Players:GetPlayers() do
		if otherPlayer.Character then table.insert(exclusions, otherPlayer.Character) end
	end
	for player, record in self._bikes do
		local chassis = record.chassis
		if not chassis.Parent then continue end
		record.raycast.FilterDescendantsInstances = exclusions
		local grounded = false
		local normalSum = Vector3.zero
		for _, z in { -WHEEL_BASE, WHEEL_BASE } do
			local center = chassis.CFrame:PointToWorldSpace(Vector3.new(0, WHEEL_HEIGHT, z))
			local hit = workspace:Raycast(center + Vector3.yAxis * 3, -Vector3.yAxis * 5.2, record.raycast)
			if hit and center.Y - hit.Position.Y <= WHEEL_RADIUS + 0.42 and center.Y - hit.Position.Y >= -0.2 and hit.Normal.Y > 0.35 then
				grounded = true
				normalSum += hit.Normal
			end
		end
		local targetNormal = if grounded then unitOr(normalSum, Vector3.yAxis) else Vector3.yAxis
		local blend = 1 - math.exp(-dt * (if grounded then 12 else 2.8))
		record.normal = unitOr(record.normal:Lerp(targetNormal, blend), Vector3.yAxis)

		local active = riding(player, record) and now - record.lastInput <= INPUT_TIMEOUT
		local throttle = if active then record.throttle else 0
		local steer = if active then record.steer else 0
		local braking = not active or record.brake
		local velocity = chassis.AssemblyLinearVelocity
		local horizontalHeading = Vector3.new(-math.sin(record.yaw), 0, -math.cos(record.yaw))
		local forward = unitOr(horizontalHeading - record.normal * horizontalHeading:Dot(record.normal), horizontalHeading)
		local speed = velocity:Dot(forward)
		local speedFraction = math.clamp(math.abs(speed) / TOP_SPEED, 0, 1)
		local movementSign = if speed < -1 then -1 else 1
		local turnRate = math.rad(125) * (1 - 0.3 * speedFraction) * math.clamp(math.abs(speed) / 10, 0, 1)
		record.yaw -= steer * movementSign * turnRate * dt * (if grounded then 1 else 0.25)
		horizontalHeading = Vector3.new(-math.sin(record.yaw), 0, -math.cos(record.yaw))
		forward = unitOr(horizontalHeading - record.normal * horizontalHeading:Dot(record.normal), horizontalHeading)
		local lean = -steer * movementSign * math.rad(14) * speedFraction * (if grounded then 1 else 0.3)
		record.balance.CFrame = CFrame.lookAt(Vector3.zero, forward, record.normal) * CFrame.Angles(0, 0, lean)

		if grounded then
			local acceleration: number
			if braking then
				acceleration = -math.sign(speed) * math.min(BRAKE_ACCELERATION, math.abs(speed) / dt)
			elseif math.abs(throttle) > 0.01 then
				local targetSpeed = throttle * (if throttle > 0 then TOP_SPEED else REVERSE_SPEED)
				local limit = if throttle * speed < -3 then BRAKE_ACCELERATION * 0.75 else ENGINE_ACCELERATION
				acceleration = math.clamp((targetSpeed - speed) * 3, -limit, limit)
			else
				acceleration = -speed * 0.65
			end
			local right = unitOr(forward:Cross(record.normal), chassis.CFrame.RightVector)
			local lateralAcceleration = -velocity:Dot(right) * 9
			record.force.Force = (forward * acceleration + right * lateralAcceleration) * chassis.AssemblyMass
		else
			-- Ballistic airtime: the engine never cancels vertical launch velocity.
			record.force.Force = Vector3.zero
		end

		-- A collision or a steep descent can exceed engine speed. This generous
		-- safety cap affects horizontal travel only, preserving jump/fall velocity.
		local horizontalVelocity = Vector3.new(velocity.X, 0, velocity.Z)
		if horizontalVelocity.Magnitude > TOP_SPEED * 1.6 then
			local limited = horizontalVelocity.Unit * TOP_SPEED * 1.6
			chassis.AssemblyLinearVelocity = Vector3.new(limited.X, velocity.Y, limited.Z)
		end
		record.wheelAngle = (record.wheelAngle - speed * dt / WHEEL_RADIUS) % (2 * math.pi)
		record.wheelElapsed += frameDt
		if record.wheelElapsed >= 1 / 20 then
			record.wheelElapsed = 0
			for index, motor in record.wheels do
				motor.C0 = record.wheelOffsets[index] * CFrame.Angles(record.wheelAngle, 0, 0)
			end
		end
	end
end

function Bikes.getBike(self: Service, player: Player): Model?
	local record = self._bikes[player]
	return if record then record.model else nil
end

function Bikes.getSpeed(self: Service, player: Player): number
	local record = self._bikes[player]
	if not record then return 0 end
	local velocity = record.chassis.AssemblyLinearVelocity
	return Vector3.new(velocity.X, 0, velocity.Z).Magnitude * STUDS_TO_KMH
end

function Bikes.getPosition(self: Service, player: Player): Vector3?
	local record = self._bikes[player]
	return if record then record.chassis.Position else nil
end

function Bikes.isRiding(self: Service, player: Player): boolean
	local record = self._bikes[player]
	return record ~= nil and riding(player, record)
end

return Bikes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Track</string>
          <string name="Source"><![CDATA[--!strict
-- A self-contained course built entirely from Roblox primitives.

local Track = {}

export type Gate = {
	cframe: CFrame,
	width: number,
}

export type Course = {
	gates: { Gate },
	checkpointCount: number,
	spawnCFrame: (self: Course, slot: number) -> CFrame,
}

local ROAD_WIDTH = 38
local ROAD_HEIGHT = 1
local ORANGE = Color3.fromRGB(255, 122, 45)
local TEAL = Color3.fromRGB(38, 209, 190)
local INK = Color3.fromRGB(27, 39, 42)
local WHITE = Color3.fromRGB(249, 245, 232)
local DIRT = Color3.fromRGB(145, 97, 59)

local POINTS = {
	Vector3.new(-180, ROAD_HEIGHT, -100),
	Vector3.new(-80, ROAD_HEIGHT, -130),
	Vector3.new(50, ROAD_HEIGHT, -130),
	Vector3.new(170, ROAD_HEIGHT, -100),
	Vector3.new(200, ROAD_HEIGHT, 0),
	Vector3.new(160, ROAD_HEIGHT, 110),
	Vector3.new(50, ROAD_HEIGHT, 140),
	Vector3.new(-80, ROAD_HEIGHT, 130),
	Vector3.new(-190, ROAD_HEIGHT, 70),
	Vector3.new(-210, ROAD_HEIGHT, -20),
}

local function folder(parent: Instance, name: string): Folder
	local result = Instance.new("Folder")
	result.Name = name
	result.Parent = parent
	return result
end

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material,
	canCollide: boolean?
): Part
	local result = Instance.new("Part")
	result.Name = name
	result.Size = size
	result.CFrame = cframe
	result.Color = color
	result.Material = material
	result.Anchored = true
	result.CanCollide = if canCollide == nil then true else canCollide
	result.CanTouch = false
	result.TopSurface = Enum.SurfaceType.Smooth
	result.BottomSurface = Enum.SurfaceType.Smooth
	result.Parent = parent
	return result
end

local function sign(board: BasePart, face: Enum.NormalId, title: string, subtitle: string)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 36
	gui.LightInfluence = 0.15
	gui.Parent = board
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.fromScale(0.94, 0.61)
	titleLabel.Position = UDim2.fromScale(0.03, 0.04)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Font = Enum.Font.GothamBlack
	titleLabel.Text = title
	titleLabel.TextColor3 = WHITE
	titleLabel.TextScaled = true
	titleLabel.Parent = gui
	local subtitleLabel = Instance.new("TextLabel")
	subtitleLabel.Name = "Subtitle"
	subtitleLabel.Size = UDim2.fromScale(0.94, 0.25)
	subtitleLabel.Position = UDim2.fromScale(0.03, 0.68)
	subtitleLabel.BackgroundTransparency = 1
	subtitleLabel.Font = Enum.Font.GothamBold
	subtitleLabel.Text = subtitle
	subtitleLabel.TextColor3 = TEAL
	subtitleLabel.TextScaled = true
	subtitleLabel.Parent = gui
end

-- The surface's end points describe the top of each slope. Subtracting
-- half the thickness along its normal keeps those points flush with the road.
local function slope(parent: Instance, name: string, from: Vector3, to: Vector3, width: number)
	local surfaceFrame = CFrame.lookAt((from + to) / 2, to)
	local thickness = 0.8
	local ramp = part(
		parent,
		name,
		Vector3.new(width, thickness, (to - from).Magnitude),
		surfaceFrame * CFrame.new(0, -thickness / 2, 0),
		DIRT,
		Enum.Material.Ground
	)
	-- The bike's contact material sets sliding resistance; lateral grip is
	-- supplied by its controller so welded contact spheres can roll over seams.
	ramp.CustomPhysicalProperties = PhysicalProperties.new(1, 0.15, 0, 1, 1)
end

local function tabletop(parent: Instance, origin: Vector3, forward: Vector3, number: number, height: number)
	local rampFolder = folder(parent, "Jump" .. number)
	local riseLength = 22
	local crestLength = 5
	local landingLength = 26
	local top = origin + forward * riseLength + Vector3.new(0, height, 0)
	local farTop = top + forward * crestLength
	local finish = farTop + forward * landingLength - Vector3.new(0, height, 0)
	slope(rampFolder, "Takeoff", origin, top, ROAD_WIDTH)
	slope(rampFolder, "Crest", top, farTop, ROAD_WIDTH)
	slope(rampFolder, "Landing", farTop, finish, ROAD_WIDTH)
	local right = forward:Cross(Vector3.yAxis)
	for _, side in { -1, 1 } do
		local markerPosition = origin + right * (ROAD_WIDTH / 2 + 3) * side
		part(rampFolder, "JumpMarker", Vector3.new(0.8, 5, 0.8), CFrame.new(markerPosition + Vector3.new(0, 2.5, 0)), ORANGE, Enum.Material.SmoothPlastic)
		local flag = part(rampFolder, "JumpFlag", Vector3.new(2.8, 1.8, 0.2), CFrame.lookAt(markerPosition + Vector3.new(0, 4.2, 0), markerPosition + forward + Vector3.new(0, 4.2, 0)), ORANGE, Enum.Material.SmoothPlastic, false)
		sign(flag, Enum.NormalId.Front, "JUMP", tostring(number))
	end
end

local function gate(parent: Instance, frame: CFrame, index: number)
	local model = folder(parent, if index == 1 then "StartFinish" else "Checkpoint" .. index)
	for _, side in { -1, 1 } do
		local color = if side < 0 then ORANGE else TEAL
		part(model, "Post", Vector3.new(2.2, 14, 2.2), frame * CFrame.new(side * (ROAD_WIDTH / 2 + 4), 7, 0), color, Enum.Material.SmoothPlastic)
		part(model, "PostFoot", Vector3.new(4, 0.7, 4), frame * CFrame.new(side * (ROAD_WIDTH / 2 + 4), 0.35, 0), INK, Enum.Material.Metal)
		part(model, "Light", Vector3.new(2.3, 0.45, 2.3), frame * CFrame.new(side * (ROAD_WIDTH / 2 + 4), 11.5, 0), WHITE, Enum.Material.Neon, false)
	end
	local board = part(model, "OverheadSign", Vector3.new(ROAD_WIDTH + 10, 5, 1.1), frame * CFrame.new(0, 14, 0), INK, Enum.Material.SmoothPlastic, false)
	local title = if index == 1 then "DIRTLINE MX" else string.format("CHECKPOINT %02d", index)
	local subtitle = if index == 1 then "START / FINISH" else "KEEP THE DIRT FLYING"
	sign(board, Enum.NormalId.Front, title, subtitle)
	sign(board, Enum.NormalId.Back, title, subtitle)
	if index == 1 then
		for row = 0, 1 do
			for column = 0, 11 do
				local color = if (row + column) % 2 == 0 then WHITE else INK
				part(model, "FinishTile", Vector3.new(ROAD_WIDTH / 12, 0.035, 1.8), frame * CFrame.new(-ROAD_WIDTH / 2 + (column + 0.5) * ROAD_WIDTH / 12, 0.025, (row - 0.5) * 1.8), color, Enum.Material.SmoothPlastic, false)
			end
		end
	else
		part(model, "CheckpointLine", Vector3.new(ROAD_WIDTH, 0.035, 0.7), frame * CFrame.new(0, 0.025, 0), TEAL, Enum.Material.SmoothPlastic, false)
	end
end

local function fenceLine(parent: Instance, from: Vector3, to: Vector3)
	local delta = to - from
	local sections = math.ceil(delta.Magnitude / 24)
	local forward = delta.Unit
	for index = 0, sections do
		local position = from:Lerp(to, index / sections)
		part(parent, "FencePost", Vector3.new(1.4, 5, 1.4), CFrame.new(position + Vector3.new(0, 2.5, 0)), Color3.fromRGB(95, 73, 51), Enum.Material.Wood)
	end
	for index = 1, sections do
		local a = from:Lerp(to, (index - 1) / sections)
		local b = from:Lerp(to, index / sections)
		for _, height in { 1.8, 3.8 } do
			part(parent, "FenceRail", Vector3.new(0.55, 0.55, (b - a).Magnitude + 0.5), CFrame.lookAt((a + b) / 2 + Vector3.new(0, height, 0), (a + b) / 2 + forward + Vector3.new(0, height, 0)), Color3.fromRGB(154, 119, 78), Enum.Material.Wood)
		end
	end
end

local function tree(parent: Instance, position: Vector3, height: number)
	part(parent, "Trunk", Vector3.new(2.4, height * 0.58, 2.4), CFrame.new(position + Vector3.new(0, height * 0.29, 0)), Color3.fromRGB(105, 78, 51), Enum.Material.Wood)
	for tier = 0, 2 do
		local radius = height * (0.46 - tier * 0.08)
		local crown = part(parent, "Foliage", Vector3.new(radius, height * 0.36, radius), CFrame.new(position + Vector3.new(0, height * (0.55 + tier * 0.17), 0)), if tier % 2 == 0 then Color3.fromRGB(58, 102, 67) else Color3.fromRGB(79, 124, 68), Enum.Material.Grass)
		crown.Shape = Enum.PartType.Ball
	end
end

local function scenery(parent: Instance)
	local fences = folder(parent, "PerimeterFence")
	local corners = {
		Vector3.new(-270, 0, -205),
		Vector3.new(270, 0, -205),
		Vector3.new(270, 0, 210),
		Vector3.new(-270, 0, 210),
	}
	for index, position in corners do
		fenceLine(fences, position, corners[index % #corners + 1])
	end
	local trees = folder(parent, "Trees")
	for index = 1, 48 do
		local angle = index / 48 * math.pi * 2
		local radius = 305 + (index % 4) * 17
		tree(trees, Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius * 0.83), 17 + (index % 5) * 3)
	end
	local mountains = folder(parent, "Mountains")
	for index = 1, 16 do
		local angle = index / 16 * math.pi * 2
		local height = 62 + (index % 5) * 17
		local radius = 420 + (index % 3) * 13
		local position = Vector3.new(math.cos(angle) * radius, height / 2 - 12, math.sin(angle) * radius * 0.83)
		local peak = Instance.new("WedgePart")
		peak.Name = "Mountain"
		peak.Size = Vector3.new(100 + (index % 3) * 22, height, 115)
		peak.CFrame = CFrame.new(position) * CFrame.Angles(0, -angle + math.pi / 2, 0)
		peak.Color = if index % 2 == 0 then Color3.fromRGB(96, 111, 103) else Color3.fromRGB(113, 125, 110)
		peak.Material = Enum.Material.Slate
		peak.Anchored = true
		peak.CanTouch = false
		peak.Parent = mountains
	end
end

local function pit(parent: Instance, start: CFrame)
	local paddock = folder(parent, "Paddock")
	local frame = start * CFrame.new(64, -ROAD_HEIGHT, 6)
	part(paddock, "PitApron", Vector3.new(62, 0.4, 62), frame * CFrame.new(0, 0.2, 0), Color3.fromRGB(123, 120, 109), Enum.Material.Concrete)
	for index = 1, 2 do
		local tent = frame * CFrame.new((index - 1.5) * 29, 0, -13)
		local color = if index == 1 then ORANGE else TEAL
		for _, x in { -11, 11 } do
			for _, z in { -9, 9 } do
				part(paddock, "TentLeg", Vector3.new(0.6, 10, 0.6), tent * CFrame.new(x, 5, z), INK, Enum.Material.Metal)
			end
		end
		part(paddock, "TentRoof", Vector3.new(25, 1.2, 21), tent * CFrame.new(0, 10.4, 0), color, Enum.Material.SmoothPlastic)
		local banner = part(paddock, "TeamBanner", Vector3.new(22, 2.4, 0.2), tent * CFrame.new(0, 8.8, 9.6), INK, Enum.Material.SmoothPlastic, false)
		sign(banner, Enum.NormalId.Back, if index == 1 then "DIRTLINE RACING" else "THE RIDER PADDOCK", "RIDE  •  JUMP  •  RACE")
		part(paddock, "Workbench", Vector3.new(14, 1, 4), tent * CFrame.new(0, 3, -5), Color3.fromRGB(174, 140, 92), Enum.Material.Wood)
		for _, x in { -5, 5 } do
			part(paddock, "WorkbenchLeg", Vector3.new(1, 3, 3), tent * CFrame.new(x, 1.5, -5), INK, Enum.Material.Metal)
		end
		part(paddock, "ToolChest", Vector3.new(5, 3.5, 3), tent * CFrame.new(7, 2.15, 3), color, Enum.Material.Metal)
	end
	for row = 1, 3 do
		local bench = frame * CFrame.new(0, 0, 10 + row * 5)
		part(paddock, "SpectatorBench", Vector3.new(42, 0.7, 2.8), bench * CFrame.new(0, 1.5 + row * 0.45, 0), Color3.fromRGB(174, 140, 92), Enum.Material.Wood)
		for _, x in { -17, 0, 17 } do
			part(paddock, "BenchLeg", Vector3.new(1.2, 1.5 + row * 0.45, 1.8), bench * CFrame.new(x, (1.5 + row * 0.45) / 2, 0), INK, Enum.Material.Metal)
		end
	end
	for index, height in { 2.5, 4, 1.5 } do
		local podium = part(paddock, "Podium", Vector3.new(6, height, 5), frame * CFrame.new((index - 2) * 6.4, height / 2 + 0.4, 6), if index == 2 then ORANGE else TEAL, Enum.Material.SmoothPlastic)
		sign(podium, Enum.NormalId.Back, tostring(if index == 1 then 2 elseif index == 2 then 1 else 3), "MX")
	end
end

function Track.build(world: Instance): Course
	local courseFolder = folder(world, "DirtlineMX")
	part(courseFolder, "Ground", Vector3.new(1060, 2, 1060), CFrame.new(0, -1, 0), Color3.fromRGB(99, 130, 77), Enum.Material.Grass)
	local road = folder(courseFolder, "Circuit")
	local checkpoints = folder(courseFolder, "Gates")
	local jumps = folder(courseFolder, "Jumps")
	local gates: { Gate } = {}
	local jumpNumber = 0
	for index, from in POINTS do
		local to = POINTS[index % #POINTS + 1]
		local delta = to - from
		local forward = delta.Unit
		local midpoint = (from + to) / 2
		local frame = CFrame.lookAt(midpoint, midpoint + forward)
		local shoulder = part(road, "DirtShoulder" .. index, Vector3.new(ROAD_WIDTH + 9, 0.24, delta.Magnitude + 4), frame * CFrame.new(0, -0.88, 0), Color3.fromRGB(163, 119, 76), Enum.Material.Ground)
		shoulder.CanTouch = false
		local surface = part(road, "Straight" .. index, Vector3.new(ROAD_WIDTH, 1, delta.Magnitude + 3), frame * CFrame.new(0, -0.5, 0), DIRT, Enum.Material.Ground)
		surface.CustomPhysicalProperties = PhysicalProperties.new(1, 0.15, 0, 1, 1)
		local corner = part(road, "WideCorner" .. index, Vector3.new(1, ROAD_WIDTH + 8, ROAD_WIDTH + 8), CFrame.new(from - Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), DIRT, Enum.Material.Ground)
		corner.Shape = Enum.PartType.Cylinder
		corner.CustomPhysicalProperties = surface.CustomPhysicalProperties
		-- The outside edge rises gently; the full road remains unobstructed.
		local bermFrame = frame * CFrame.new(-(ROAD_WIDTH / 2 + 3), 0.25, 0) * CFrame.Angles(0, 0, -math.rad(12))
		part(road, "OutsideBerm" .. index, Vector3.new(6, 0.8, math.max(12, delta.Magnitude - 24)), bermFrame, Color3.fromRGB(133, 88, 53), Enum.Material.Ground)
		-- Four easy tabletop jumps leave a flat approach to the next gate.
		if index == 2 or index == 4 or index == 7 or index == 9 then
			jumpNumber += 1
			local jumpOrigin = from + forward * 12
			tabletop(jumps, jumpOrigin, forward, jumpNumber, if index == 9 then 3 else 4)
		end
		local gateFraction = if index == 1 then 0.6 else 0.83
		local gatePosition = from + delta * gateFraction
		local gateFrame = CFrame.lookAt(gatePosition, gatePosition + forward)
		table.insert(gates, { cframe = gateFrame, width = ROAD_WIDTH })
		gate(checkpoints, gateFrame, index)
	end
	local decorations = folder(courseFolder, "Scenery")
	scenery(decorations)
	pit(decorations, gates[1].cframe)
	local result: Course = {
		gates = gates,
		checkpointCount = #gates,
		spawnCFrame = function(self: Course, slot: number): CFrame
			local safeSlot = math.clamp(math.floor(slot), 1, 8) - 1
			local lane = (safeSlot % 4 - 1.5) * 6
			local row = math.floor(safeSlot / 4)
			return self.gates[1].cframe * CFrame.new(lane, 4, 24 + row * 6)
		end,
	}
	return result
end

return Track
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local shared = ReplicatedStorage:WaitForChild("Motocross")
local Config = require(shared:WaitForChild("Config"))
local RaceRules = require(shared:WaitForChild("RaceRules"))
local Bikes = require(script.Parent:WaitForChild("Bikes"))
local Track = require(script.Parent:WaitForChild("Track"))

local world = Instance.new("Folder")
world.Name = "DirtlineMX"
world.Parent = workspace
local track = Track.build(world)
local bikes = Bikes.new(world)

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = shared
local function remote(name: string): RemoteEvent
	local event = Instance.new("RemoteEvent")
	event.Name = name
	event.Parent = remotes
	return event
end
local input = remote("Input")
local action = remote("Action")
local stateEvent = remote("State")

type Rider = {
	race: RaceRules.State,
	slot: number,
	lastPosition: Vector3?,
	lastReset: number,
	respawning: boolean,
	message: string,
	messageUntil: number,
	laps: IntValue,
	best: NumberValue,
	characterConnection: RBXScriptConnection?,
}
local riders: { [Player]: Rider } = {}
local nextSlot = 0

local function setMessage(rider: Rider, text: string)
	rider.message = text
	rider.messageUntil = workspace:GetServerTimeNow() + 5
end

local function respawn(player: Player)
	local rider = riders[player]
	if not rider or not player.Character or not player.Character.Parent then
		return
	end
	if rider.respawning then
		return
	end
	rider.respawning = true
	rider.lastReset = workspace:GetServerTimeNow()
	rider.lastPosition = nil
	RaceRules.reset(rider.race)
	setMessage(rider, "Cross START / FINISH to start your lap")
	bikes:spawn(player, track:spawnCFrame(rider.slot))
	rider.respawning = false
end

local function addPlayer(player: Player)
	if riders[player] then
		return
	end
	nextSlot += 1
	local leaderboard = Instance.new("Folder")
	leaderboard.Name = "leaderstats"
	leaderboard.Parent = player
	local laps = Instance.new("IntValue")
	laps.Name = "Laps"
	laps.Parent = leaderboard
	local best = Instance.new("NumberValue")
	best.Name = "BestLap"
	best.Parent = leaderboard
	local rider: Rider = {
		race = RaceRules.new(track.checkpointCount),
		slot = (nextSlot - 1) % 8 + 1,
		lastPosition = nil,
		lastReset = -math.huge,
		respawning = false,
		message = "",
		messageUntil = 0,
		laps = laps,
		best = best,
		characterConnection = nil,
	}
	riders[player] = rider
	rider.characterConnection = player.CharacterAdded:Connect(function()
		task.defer(respawn, player)
	end)
	if player.Character then
		task.defer(respawn, player)
	end
end

input.OnServerEvent:Connect(function(player, throttle, steer, brake)
	-- Bikes verifies argument types, rates, range and ownership of the occupied seat.
	bikes:input(player, throttle, steer, brake)
end)

action.OnServerEvent:Connect(function(player, command)
	if command ~= "Respawn" then
		return
	end
	local rider = riders[player]
	if rider and not rider.respawning and workspace:GetServerTimeNow() - rider.lastReset >= Config.ResetCooldown then
		task.defer(respawn, player)
	end
end)

Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(function(player)
	local rider = riders[player]
	if rider and rider.characterConnection then
		rider.characterConnection:Disconnect()
	end
	bikes:remove(player)
	riders[player] = nil
end)
for _, player in Players:GetPlayers() do
	addPlayer(player)
end

local sinceSnapshot = 0
RunService.Heartbeat:Connect(function(dt)
	bikes:update(dt)
	sinceSnapshot += dt
	local publish = sinceSnapshot >= Config.StateInterval
	if publish then
		sinceSnapshot %= Config.StateInterval
	end
	local now = workspace:GetServerTimeNow()
	for player, rider in riders do
		local position = bikes:getPosition(player)
		if position and not rider.respawning then
			if position.Y < Config.OutOfBoundsY or math.abs(position.X) > Config.ArenaLimit or math.abs(position.Z) > Config.ArenaLimit then
				if now - rider.lastReset >= Config.ResetCooldown then
					task.defer(respawn, player)
				end
			elseif bikes:isRiding(player) then
				local previous = rider.lastPosition
				if previous then
					local gate = track.gates[rider.race.nextCheckpoint]
					local before = gate.cframe:PointToObjectSpace(previous)
					local after = gate.cframe:PointToObjectSpace(position)
					if RaceRules.crossedGate(
						{ x = before.X, y = before.Y, z = before.Z },
						{ x = after.X, y = after.Y, z = after.Z },
						gate.width
					) then
						local accepted, completed = RaceRules.cross(rider.race, rider.race.nextCheckpoint, now)
						if accepted then
							if completed then
								rider.laps.Value = rider.race.lapsFinished
								rider.best.Value = math.floor((rider.race.bestLap or 0) * 100) / 100
								setMessage(rider, string.format("LAP COMPLETE  %.2fs  —  keep riding!", completed))
							elseif rider.race.nextCheckpoint == 2 then
								setMessage(rider, "Lap started — follow the numbered gates")
							else
								setMessage(rider, string.format("Gate cleared — next gate %d", rider.race.nextCheckpoint))
							end
						end
					end
				end
				rider.lastPosition = position
			else
				rider.lastPosition = nil
			end
		end
		if publish then
			stateEvent:FireClient(player, {
				speed = bikes:getSpeed(player),
				lap = rider.race.lap,
				nextCheckpoint = rider.race.nextCheckpoint,
				checkpointCount = rider.race.checkpointCount,
				lapTime = if rider.race.lapStart then now - rider.race.lapStart else 0,
				bestLap = rider.race.bestLap,
				lapsFinished = rider.race.lapsFinished,
				racing = rider.race.lapStart ~= nil,
				message = if now < rider.messageUntil then rider.message else nil,
			})
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="10">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="11">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="12">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="13">
        <Properties>
          <string name="Name">MotocrossClient</string>
          <string name="Source"><![CDATA[--!strict
-- The bike is server simulated. This client sends controls and renders race state.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Motocross"):WaitForChild("Remotes")
local inputRemote = remotes:WaitForChild("Input") :: RemoteEvent
local actionRemote = remotes:WaitForChild("Action") :: RemoteEvent
local stateRemote = remotes:WaitForChild("State") :: RemoteEvent

local colors = {
	panel = Color3.fromRGB(16, 24, 36),
	panelLight = Color3.fromRGB(27, 39, 54),
	border = Color3.fromRGB(60, 77, 93),
	text = Color3.fromRGB(244, 248, 252),
	muted = Color3.fromRGB(155, 176, 194),
	orange = Color3.fromRGB(255, 128, 54),
	teal = Color3.fromRGB(64, 236, 201),
}

local function create(className: string, parent: Instance, properties: { [string]: any }): any
	local instance = Instance.new(className)
	for key, value in pairs(properties) do
		(instance :: any)[key] = value
	end
	instance.Parent = parent
	return instance
end

local function corner(parent: Instance, radius: number)
	create("UICorner", parent, { CornerRadius = UDim.new(0, radius) })
end

local function label(parent: Instance, text: string, position: UDim2, size: UDim2, fontSize: number, color: Color3?): TextLabel
	return create("TextLabel", parent, {
		BackgroundTransparency = 1,
		Position = position,
		Size = size,
		Font = Enum.Font.GothamMedium,
		Text = text,
		TextSize = fontSize,
		TextColor3 = color or colors.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	})
end

local gui = create("ScreenGui", player:WaitForChild("PlayerGui"), {
	Name = "DirtlineHUD",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	DisplayOrder = 10,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}) :: ScreenGui

local panelScales: { UIScale } = {}
local function panel(name: string, position: UDim2, size: UDim2, anchor: Vector2): Frame
	local frame = create("Frame", gui, {
		Name = name,
		Position = position,
		Size = size,
		AnchorPoint = anchor,
		BackgroundColor3 = colors.panel,
		BackgroundTransparency = 0.09,
		BorderSizePixel = 0,
	}) :: Frame
	corner(frame, 14)
	create("UIStroke", frame, { Color = colors.border, Transparency = 0.5, Thickness = 1 })
	table.insert(panelScales, create("UIScale", frame, { Scale = 1 }))
	return frame
end

local brand = panel("Brand", UDim2.fromOffset(16, 16), UDim2.fromOffset(240, 108), Vector2.zero)
create("Frame", brand, {
	Position = UDim2.fromOffset(0, 17),
	Size = UDim2.fromOffset(4, 42),
	BackgroundColor3 = colors.orange,
	BorderSizePixel = 0,
})
local title = label(brand, "DIRTLINE MX", UDim2.fromOffset(16, 12), UDim2.fromOffset(213, 31), 25)
title.Font = Enum.Font.GothamBlack
label(brand, "MOTOCROSS TIME TRIAL", UDim2.fromOffset(17, 44), UDim2.fromOffset(210, 18), 10, colors.muted)
local resetButton = create("TextButton", brand, {
	Name = "ResetBike",
	Position = UDim2.fromOffset(16, 72),
	Size = UDim2.fromOffset(208, 26),
	BackgroundColor3 = colors.panelLight,
	BorderSizePixel = 0,
	AutoButtonColor = true,
	Text = "R  /  Y     RESET BIKE",
	Font = Enum.Font.GothamBold,
	TextSize = 10,
	TextColor3 = colors.text,
}) :: TextButton
corner(resetButton, 6)

local timing = panel("Timing", UDim2.new(1, -16, 0, 16), UDim2.fromOffset(244, 108), Vector2.new(1, 0))
label(timing, "LAP TIME", UDim2.fromOffset(16, 11), UDim2.fromOffset(210, 17), 10, colors.muted)
local timeLabel = label(timing, "00:00.00", UDim2.fromOffset(14, 29), UDim2.fromOffset(219, 37), 32)
timeLabel.Font = Enum.Font.GothamBold
local bestLabel = label(timing, "BEST    --:--.--", UDim2.fromOffset(16, 78), UDim2.fromOffset(212, 18), 13, colors.teal)

local status = panel("Status", UDim2.new(0.5, 0, 0, 137), UDim2.fromOffset(430, 48), Vector2.new(0.5, 0))
local statusLabel = label(status, "CROSS THE START GATE TO BEGIN", UDim2.fromOffset(12, 0), UDim2.new(1, -24, 1, 0), 14, colors.teal)
statusLabel.TextXAlignment = Enum.TextXAlignment.Center

local speedPanel = panel("Speed", UDim2.new(0, 16, 1, -16), UDim2.fromOffset(214, 120), Vector2.new(0, 1))
label(speedPanel, "GROUND SPEED", UDim2.fromOffset(16, 11), UDim2.fromOffset(188, 16), 10, colors.muted)
local speedLabel = label(speedPanel, "0", UDim2.fromOffset(13, 26), UDim2.fromOffset(128, 62), 52)
speedLabel.Font = Enum.Font.GothamBlack
label(speedPanel, "KM/H", UDim2.fromOffset(143, 62), UDim2.fromOffset(60, 21), 12, colors.muted)
local speedTrack = create("Frame", speedPanel, {
	Position = UDim2.fromOffset(16, 99),
	Size = UDim2.new(1, -32, 0, 5),
	BackgroundColor3 = colors.panelLight,
	BorderSizePixel = 0,
}) :: Frame
corner(speedTrack, 3)
local speedFill = create("Frame", speedTrack, {
	Size = UDim2.fromScale(0, 1),
	BackgroundColor3 = colors.orange,
	BorderSizePixel = 0,
}) :: Frame
corner(speedFill, 3)

local progressPanel = panel("Progress", UDim2.new(0.5, 0, 1, -16), UDim2.fromOffset(330, 90), Vector2.new(0.5, 1))
local lapLabel = label(progressPanel, "LAP 01", UDim2.fromOffset(16, 12), UDim2.new(1, -32, 0, 23), 19)
lapLabel.Font = Enum.Font.GothamBold
local gateLabel = label(progressPanel, "NEXT GATE  01 / 01", UDim2.fromOffset(16, 38), UDim2.new(1, -32, 0, 18), 11, colors.muted)
local progressTrack = create("Frame", progressPanel, {
	Position = UDim2.fromOffset(16, 69),
	Size = UDim2.new(1, -32, 0, 5),
	BackgroundColor3 = colors.panelLight,
	BorderSizePixel = 0,
}) :: Frame
corner(progressTrack, 3)
local progressFill = create("Frame", progressTrack, {
	Size = UDim2.fromScale(0, 1),
	BackgroundColor3 = colors.teal,
	BorderSizePixel = 0,
}) :: Frame
corner(progressFill, 3)

local controlsPanel = panel("Controls", UDim2.new(1, -16, 1, -16), UDim2.fromOffset(250, 90), Vector2.new(1, 1))
label(controlsPanel, "RIDE CONTROLS", UDim2.fromOffset(16, 10), UDim2.fromOffset(220, 17), 10, colors.orange)
local controlsLabel = label(controlsPanel, "W / S  Gas / reverse   A / D  Steer\nSPACE  Brake   R  Reset bike", UDim2.fromOffset(16, 32), UDim2.fromOffset(220, 43), 11, colors.muted)
controlsLabel.TextYAlignment = Enum.TextYAlignment.Top
controlsLabel.TextWrapped = true

local intro = panel("Welcome", UDim2.fromScale(0.5, 0.47), UDim2.fromOffset(520, 250), Vector2.new(0.5, 0.5))
intro.ZIndex = 5
local introTitle = label(intro, "FIND YOUR LINE.", UDim2.fromOffset(24, 18), UDim2.new(1, -48, 0, 38), 29)
introTitle.Font = Enum.Font.GothamBlack
label(intro, "Cross the start gate, then follow every numbered gate.\nKeep the wheels planted and chase your best lap.", UDim2.fromOffset(24, 64), UDim2.new(1, -48, 0, 48), 15, colors.muted).TextWrapped = true
local introControls = label(intro, "W / S  Gas / reverse   A / D  Steer\nSPACE  Brake   R  Reset bike / restart lap", UDim2.fromOffset(24, 128), UDim2.new(1, -48, 0, 44), 13)
introControls.TextWrapped = true
local dismissButton = create("TextButton", intro, {
	Position = UDim2.fromOffset(24, 188),
	Size = UDim2.new(1, -48, 0, 40),
	BackgroundColor3 = colors.orange,
	BorderSizePixel = 0,
	AutoButtonColor = true,
	Text = "LET'S RIDE",
	TextColor3 = colors.panel,
	TextSize = 14,
	Font = Enum.Font.GothamBold,
}) :: TextButton
corner(dismissButton, 8)

local introDismissed = false
local function dismissIntro()
	if introDismissed then
		return
	end
	introDismissed = true
	intro.Visible = false
end
dismissButton.Activated:Connect(dismissIntro)
task.delay(10, dismissIntro)

local seated = false
local focused = true
local menuOpen = false
local heldKeys: { [Enum.KeyCode]: boolean } = {}
local touchHeld: { [string]: { [InputObject]: boolean } } = {}
local stickSteer = 0
local triggerGas = 0
local triggerBrake = 0
local lastReset = -math.huge
local touchButtons: { TextButton } = {}

local function canDrive(): boolean
	return seated and focused and not menuOpen and UserInputService:GetFocusedTextBox() == nil
end

local function clearControls()
	table.clear(heldKeys)
	for _, touches in pairs(touchHeld) do
		table.clear(touches)
	end
	stickSteer = 0
	triggerGas = 0
	triggerBrake = 0
	-- A release packet must not wait for the next periodic update.
	inputRemote:FireServer(0, 0, false)
	for _, button in ipairs(touchButtons) do
		button.BackgroundColor3 = colors.panel
	end
end

local function resetBike()
	if not focused or menuOpen or UserInputService:GetFocusedTextBox() ~= nil then
		return
	end
	if os.clock() - lastReset < 0.8 then
		return
	end
	lastReset = os.clock()
	clearControls()
	actionRemote:FireServer("Respawn")
	dismissIntro()
end
resetButton.Activated:Connect(resetBike)

local function touchPressed(action: string): boolean
	return touchHeld[action] ~= nil and next(touchHeld[action]) ~= nil
end

local function controls(): (number, number, boolean)
	local forward = (heldKeys[Enum.KeyCode.W] or heldKeys[Enum.KeyCode.Up] or touchPressed("gas")) and 1 or 0
	local reverse = (heldKeys[Enum.KeyCode.S] or heldKeys[Enum.KeyCode.Down] or heldKeys[Enum.KeyCode.ButtonX] or touchPressed("reverse")) and 1 or 0
	local left = (heldKeys[Enum.KeyCode.A] or heldKeys[Enum.KeyCode.Left] or touchPressed("left")) and 1 or 0
	local right = (heldKeys[Enum.KeyCode.D] or heldKeys[Enum.KeyCode.Right] or touchPressed("right")) and 1 or 0
	local throttle = math.clamp(math.max(forward, triggerGas) - reverse, -1, 1)
	local steer = math.clamp(right - left + stickSteer, -1, 1)
	local brake = heldKeys[Enum.KeyCode.Space] == true or triggerBrake > 0.15 or touchPressed("brake")
	return throttle, steer, brake
end

local function handleControl(actionName: string, inputState: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
	local key = input.KeyCode
	local released = inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel
	if released then
		heldKeys[key] = nil
		if key == Enum.KeyCode.Thumbstick1 then
			stickSteer = 0
		elseif key == Enum.KeyCode.ButtonR2 then
			triggerGas = 0
		elseif key == Enum.KeyCode.ButtonL2 then
			triggerBrake = 0
		end
	end
	-- Reset also works after a crash or dismount, when normal controls pass through.
	if actionName == "DirtlineReset" then
		if not focused or menuOpen or UserInputService:GetFocusedTextBox() ~= nil then
			return Enum.ContextActionResult.Pass
		end
		if inputState == Enum.UserInputState.Begin then
			resetBike()
		end
		return Enum.ContextActionResult.Sink
	end
	if not canDrive() then
		return Enum.ContextActionResult.Pass
	end
	if not released then
		if key == Enum.KeyCode.Thumbstick1 then
			local x = input.Position.X
			stickSteer = if math.abs(x) < 0.12 then 0 else math.sign(x) * ((math.abs(x) - 0.12) / 0.88)
		elseif key == Enum.KeyCode.ButtonR2 then
			triggerGas = math.clamp(input.Position.Z, 0, 1)
		elseif key == Enum.KeyCode.ButtonL2 then
			triggerBrake = math.clamp(input.Position.Z, 0, 1)
		else
			heldKeys[key] = true
		end
		if key == Enum.KeyCode.W or key == Enum.KeyCode.Up or key == Enum.KeyCode.ButtonR2 then
			dismissIntro()
		end
	end
	return Enum.ContextActionResult.Sink
end

-- These return Pass whenever the rider leaves their seat, retaining Roblox movement.
ContextActionService:BindActionAtPriority("DirtlineThrottle", handleControl, false, 3000,
	Enum.KeyCode.W, Enum.KeyCode.S, Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonX)
ContextActionService:BindActionAtPriority("DirtlineSteer", handleControl, false, 3000,
	Enum.KeyCode.A, Enum.KeyCode.D, Enum.KeyCode.Left, Enum.KeyCode.Right, Enum.KeyCode.Thumbstick1)
ContextActionService:BindActionAtPriority("DirtlineBrake", handleControl, false, 3000,
	Enum.KeyCode.Space, Enum.KeyCode.ButtonL2)
ContextActionService:BindActionAtPriority("DirtlineReset", handleControl, false, 3000,
	Enum.KeyCode.R, Enum.KeyCode.ButtonY)

local touchLayer = create("Frame", gui, {
	Name = "TouchControls",
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Visible = false,
}) :: Frame

local function touchButton(action: string, text: string, position: UDim2, anchor: Vector2)
	touchHeld[action] = {}
	local button = create("TextButton", touchLayer, {
		Name = action,
		Position = position,
		Size = UDim2.fromOffset(64, 64),
		AnchorPoint = anchor,
		BackgroundColor3 = colors.panel,
		BackgroundTransparency = 0.12,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = text,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextColor3 = if action == "gas" then colors.teal else colors.text,
	}) :: TextButton
	corner(button, 16)
	create("UIStroke", button, { Color = colors.border, Transparency = 0.25, Thickness = 1 })
	table.insert(touchButtons, button)
	button.InputBegan:Connect(function(input: InputObject)
		if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and canDrive() then
			touchHeld[action][input] = true
			button.BackgroundColor3 = colors.panelLight
			dismissIntro()
		end
	end)
	button.InputEnded:Connect(function(input: InputObject)
		touchHeld[action][input] = nil
		if not touchPressed(action) then
			button.BackgroundColor3 = colors.panel
		end
	end)
end
touchButton("left", "LEFT", UDim2.new(0, 16, 1, -16), Vector2.new(0, 1))
touchButton("right", "RIGHT", UDim2.new(0, 88, 1, -16), Vector2.new(0, 1))
touchButton("gas", "GAS", UDim2.new(1, -16, 1, -88), Vector2.new(1, 1))
touchButton("brake", "BRAKE", UDim2.new(1, -16, 1, -16), Vector2.new(1, 1))
touchButton("reverse", "BACK", UDim2.new(1, -88, 1, -16), Vector2.new(1, 1))

-- InputEnded is global so dragging a finger off a control cannot leave it held.
UserInputService.InputEnded:Connect(function(input: InputObject)
	for _, touches in pairs(touchHeld) do
		touches[input] = nil
	end
	for _, button in ipairs(touchButtons) do
		if not touchPressed(button.Name) then
			button.BackgroundColor3 = colors.panel
		end
	end
	heldKeys[input.KeyCode] = nil
end)
UserInputService.WindowFocusReleased:Connect(function()
	focused = false
	clearControls()
end)
UserInputService.WindowFocused:Connect(function()
	focused = true
end)
UserInputService.TextBoxFocused:Connect(clearControls)
GuiService.MenuOpened:Connect(function()
	menuOpen = true
	clearControls()
end)
GuiService.MenuClosed:Connect(function()
	menuOpen = false
end)
UserInputService.GamepadDisconnected:Connect(clearControls)

local function ownsSeat(seat: BasePart?): boolean
	if seat == nil or not seat:IsA("VehicleSeat") or seat.Name ~= "DriverSeat" then
		return false
	end
	local ancestor: Instance? = seat
	while ancestor and ancestor ~= workspace do
		if ancestor:GetAttribute("OwnerUserId") == player.UserId then
			return true
		end
		ancestor = ancestor.Parent
	end
	return false
end

local function updateSeat(humanoid: Humanoid)
	local nextSeated = humanoid.Health > 0 and ownsSeat(humanoid.SeatPart)
	if seated ~= nextSeated then
		seated = nextSeated
		clearControls()
	end
	touchLayer.Visible = seated and UserInputService.TouchEnabled
end

local characterConnections: { RBXScriptConnection } = {}
local function watchCharacter(character: Model)
	for _, connection in ipairs(characterConnections) do
		connection:Disconnect()
	end
	table.clear(characterConnections)
	seated = false
	touchLayer.Visible = false
	clearControls()
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid == nil or not humanoid:IsA("Humanoid") or player.Character ~= character then
		return
	end
	table.insert(characterConnections, humanoid:GetPropertyChangedSignal("SeatPart"):Connect(function()
		updateSeat(humanoid)
	end))
	table.insert(characterConnections, humanoid.Died:Connect(function()
		updateSeat(humanoid)
	end))
	updateSeat(humanoid)
end
player.CharacterAdded:Connect(watchCharacter)
if player.Character then
	task.spawn(watchCharacter, player.Character)
end

local function layout()
	local camera = workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local scale = math.clamp(math.min(viewport.X / 1120, viewport.Y / 690), 0.56, 1)
	for _, panelScale in ipairs(panelScales) do
		panelScale.Scale = scale
	end
	status.Position = UDim2.new(0.5, 0, 0, 16 + 108 * scale + 12)
	local mobile = UserInputService.TouchEnabled
	touchLayer.Visible = seated and mobile
	local compact = viewport.X < 930 or mobile
	controlsPanel.Visible = not compact
	progressPanel.AnchorPoint = if compact then Vector2.new(1, 1) else Vector2.new(0.5, 1)
	progressPanel.Position = if compact then UDim2.new(1, -16, 1, if mobile then -165 else -16) else UDim2.new(0.5, 0, 1, -16)
	progressPanel.Size = UDim2.fromOffset(if viewport.X < 500 then 260 else 330, 90)
	speedPanel.Position = UDim2.new(0, 16, 1, if mobile then -165 else -16)
	resetButton.Text = if mobile then "RESET BIKE / RESTART LAP" else "R  /  Y     RESET BIKE"
	if mobile then
		introControls.Text = "LEFT / RIGHT  Steer   GAS  Accelerate\nBRAKE  Slow down   BACK  Reverse"
	elseif UserInputService.GamepadEnabled then
		introControls.Text = "Left stick  Steer   RT  Gas   LT  Brake\nX  Reverse   Y  Reset bike / restart lap"
		controlsLabel.Text = "Left stick  Steer   RT  Gas   LT  Brake\nX  Reverse   Y  Reset bike"
	else
		introControls.Text = "W / S  Gas / reverse   A / D  Steer\nSPACE  Brake   R  Reset bike / restart lap"
	end
end
local viewportConnection: RBXScriptConnection? = nil
local function watchCamera()
	if viewportConnection then
		viewportConnection:Disconnect()
	end
	local camera = workspace.CurrentCamera
	if camera then
		viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(layout)
	end
	layout()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(layout)
UserInputService.GamepadConnected:Connect(layout)
watchCamera()

local race = {
	speed = 0,
	lap = 1,
	nextCheckpoint = 1,
	checkpointCount = 1,
	lapTime = 0,
	bestLap = nil :: number?,
	lapsFinished = 0,
	racing = false,
}
local receivedAt = os.clock()
local eventMessage = ""
local eventMessageUntil = 0

local function finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) < 1e9
end

local function timeText(seconds: number): string
	local hundredths = math.floor(math.max(seconds, 0) * 100)
	return string.format("%02d:%02d.%02d", math.floor(hundredths / 6000), math.floor(hundredths / 100) % 60, hundredths % 100)
end

stateRemote.OnClientEvent:Connect(function(snapshot: any)
	if type(snapshot) ~= "table" then
		return
	end
	if finite(snapshot.speed) then
		race.speed = math.clamp(snapshot.speed, 0, 500)
	end
	if finite(snapshot.lap) then
		race.lap = math.clamp(math.floor(snapshot.lap), 1, 99999)
	end
	if finite(snapshot.checkpointCount) then
		race.checkpointCount = math.clamp(math.floor(snapshot.checkpointCount), 1, 999)
	end
	if finite(snapshot.nextCheckpoint) then
		race.nextCheckpoint = math.clamp(math.floor(snapshot.nextCheckpoint), 1, race.checkpointCount)
	end
	if finite(snapshot.lapTime) then
		race.lapTime = math.clamp(snapshot.lapTime, 0, 86400)
		receivedAt = os.clock()
	end
	if finite(snapshot.bestLap) and snapshot.bestLap > 0 then
		race.bestLap = math.clamp(snapshot.bestLap, 0, 86400)
	end
	if finite(snapshot.lapsFinished) then
		race.lapsFinished = math.clamp(math.floor(snapshot.lapsFinished), 0, 99999)
	end
	if type(snapshot.racing) == "boolean" then
		race.racing = snapshot.racing
	end
	if type(snapshot.message) == "string" and snapshot.message ~= "" then
		local message = string.sub(snapshot.message, 1, 100)
		if eventMessage ~= message then
			eventMessage = message
			eventMessageUntil = os.clock() + 3
		end
	elseif snapshot.message == nil then
		eventMessage = ""
		eventMessageUntil = 0
	end
	lapLabel.Text = string.format("LAP %02d", race.lap)
	gateLabel.Text = if race.racing and race.nextCheckpoint == 1 then "NEXT GATE  START / FINISH" else string.format("NEXT GATE  %02d / %02d", race.nextCheckpoint, race.checkpointCount)
	local cleared = if race.racing and race.nextCheckpoint == 1 then race.checkpointCount else race.nextCheckpoint - 1
	progressFill.Size = UDim2.fromScale(cleared / race.checkpointCount, 1)
	bestLabel.Text = "BEST    " .. (if race.bestLap then timeText(race.bestLap) else "--:--.--")
end)

local sendAccumulator = 0
local displayedSpeed = 0
RunService.Heartbeat:Connect(function(deltaTime: number)
	sendAccumulator += deltaTime
	if sendAccumulator >= 1 / 15 then
		sendAccumulator %= 1 / 15
		if canDrive() then
			local throttle, steer, brake = controls()
			inputRemote:FireServer(throttle, steer, brake)
		end
	end
end)

RunService.RenderStepped:Connect(function(deltaTime: number)
	displayedSpeed += (race.speed - displayedSpeed) * math.min(1, deltaTime * 9)
	speedLabel.Text = tostring(math.floor(displayedSpeed + 0.5))
	speedFill.Size = UDim2.fromScale(math.clamp(displayedSpeed / 120, 0, 1), 1)
	-- Extrapolation is capped if updates stop, so a disconnected client cannot invent laps.
	local extrapolated = if race.racing then math.min(os.clock() - receivedAt, 1) else 0
	timeLabel.Text = timeText(race.lapTime + extrapolated)
	if os.clock() < eventMessageUntil then
		statusLabel.Text = eventMessage
	elseif not seated then
		statusLabel.Text = "RESET YOUR BIKE TO GET BACK ON TRACK"
	elseif race.racing and race.nextCheckpoint == 1 then
		statusLabel.Text = "CROSS START / FINISH TO COMPLETE YOUR LAP"
	elseif race.racing then
		statusLabel.Text = string.format("LAP %02d  /  FOLLOW GATE %02d", race.lap, race.nextCheckpoint)
	else
		statusLabel.Text = "CROSS THE START GATE TO BEGIN"
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="14">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-100</float>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>