; Standalone desktop prototype. One Godot unit = one metre.
config_version=5

[application]
config/name="Dirtline MX"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="250F motocross simulation prototype"
config/version="0.7.0"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]
3d/physics_engine="Jolt Physics"
3d/default_gravity=9.81
common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=32
jolt_physics_3d/limits/max_angular_velocity=250.0
jolt_physics_3d/collisions/collision_margin_fraction=0.9

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.35, 0.52, 0.7, 1)

[audio]
driver/enable_input=false

[threading]
worker_pool/max_threads=2
